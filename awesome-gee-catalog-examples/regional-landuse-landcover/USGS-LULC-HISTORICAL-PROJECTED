// =============================================
// NLCD → USGS LULC class mapping
// =============================================
var nlcdFromValues = [11, 12, 21, 22, 23, 24, 31, 41, 42, 43, 52, 71, 81, 82, 90, 95];
var nlcdToValues   = [ 1, 17,  2,  2,  2,  2,  7,  8,  9, 10, 12, 11, 14, 13, 16, 15];

// ----- Remap helpers -----
function remapUsgs(image) {
  return image.remap(
    lulcClassValues,
    ee.List.sequence(0, lulcClassValues.length - 1)
  );
}

function remapNlcd(image) {
  var unified = image.remap(nlcdFromValues, nlcdToValues);
  return unified.remap(
    lulcClassValues,
    ee.List.sequence(0, lulcClassValues.length - 1)
  );
}

var visParams = {
  min: 0,
  max: lulcClassValues.length - 1,
  palette: lulcPalette
};

// ----- Get image for any dataset + year -----
function getImage(datasetName, year) {
  var ds = datasets[datasetName];
  if (ds.source === 'nlcd') {
    var nlcdImg = nlcd
      .filter(ee.Filter.calendarRange(year, year, 'year'))
      .first().rename('landcover');
    return remapNlcd(nlcdImg);
  } else {
    var usgsImg = usgsLulc
      .filter(ee.Filter.eq('scenario', ds.scenario))
      .filter(ee.Filter.calendarRange(year, year, 'year'))
      .first().rename('landcover');
    return remapUsgs(usgsImg);
  }
}

