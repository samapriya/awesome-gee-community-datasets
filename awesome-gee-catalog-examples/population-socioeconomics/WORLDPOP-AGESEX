// Main function to update visualization
function updateVisualization(year, vizType) {
  // Validate year
  if (!year || isNaN(year) || year < 2000 || year > 2023) {
    print('Invalid year: ' + year + '. Must be between 2000 and 2023.');
    return;
  }
  
  // Remove current layer
  if (currentLayer) {
    Map.remove(currentLayer);
    currentLayer = null;
  }
  
  try {
    print('Loading data for year: ' + year);
    
    // Load data
    var data = loadAgeSexData(year);
    
    // Select appropriate data and visualization parameters
    var imageToShow = data[vizType];
    var vis = visParams[vizType];
    
    // Add layer
    currentLayer = ui.Map.Layer(imageToShow, vis, vis.label + ' ' + year);
    Map.layers().insert(0, currentLayer);
    
    // Update info panel and legend
    updateInfoPanel(year, vizType);
    updateLegend(vis);
    
    print('Successfully loaded ' + vis.label + ' for ' + year);
    
  } catch(error) {
    print('Error loading data:', error);
  }
}

// Function called by date slider
function showPopulationForYear(dateRange) {
  // Check if dateRange exists
  if (!dateRange) {
    return;
  }
  
  // Use start() method to get the date from the date range
  var startDate = ee.Date(dateRange.start());
  var year = startDate.get('year').getInfo();
  
  if (year && !isNaN(year) && year >= 2000 && year <= 2023) {
    updateVisualization(year, currentVisualization);
  }
}

// Update information panel
function updateInfoPanel(year, vizType) {
  var vis = visParams[vizType];
  infoLabel.setValue([
    'WorldPop Age-Sex Population Data',
    'Year: ' + year,
    'View: ' + vis.label,
    'Resolution: 100m',
    'Scale: ' + vis.min + '-' + vis.max + ' ' + vis.unit,
    '',
    'Zoom or select an area from the list below'
  ].join('\n'));
}

// Update legend
function updateLegend(vis) {
  // Clear existing legend content
  legendPanel.clear();
  
  var legendTitle = ui.Label(vis.label, {
    fontWeight: 'bold',
    fontSize: '14px',
    margin: '0 0 10px 0'
  });
  
  // Color bar
  var colorBar = ui.Thumbnail({
    image: ee.Image.pixelLonLat().select(0),
    params: {
      bbox: [0, 0, 1, 0.1],
      dimensions: '200x25',
      format: 'png',
      min: 0,
      max: 1,
      palette: vis.palette
    },
    style: {stretch: 'horizontal', margin: '0 0 5px 0'}
  });
  
  var legendLabels = ui.Panel({
    widgets: [
      ui.Label(vis.min.toString(), {fontSize: '11px', margin: '0 5px'}),
      ui.Label(vis.unit, {
        textAlign: 'center',
        stretch: 'horizontal',
        fontSize: '11px',
        margin: '0 10px'
      }),
      ui.Label(vis.max.toString() + '+', {fontSize: '11px', margin: '0 5px'})
    ],
    layout: ui.Panel.Layout.flow('horizontal')
  });
  
  legendPanel.add(legendTitle);
  legendPanel.add(colorBar);
  legendPanel.add(legendLabels);
}

