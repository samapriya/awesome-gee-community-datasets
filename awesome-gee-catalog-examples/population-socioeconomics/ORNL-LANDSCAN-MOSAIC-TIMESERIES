// Function to select random city and zoom to it
function zoomToRandomCity() {
  var randomIndex = Math.floor(Math.random() * majorCities.length);
  var selectedCity = majorCities[randomIndex];

  // Set map center and zoom
  Map.setCenter(selectedCity.lon, selectedCity.lat, selectedCity.zoom);

  // Update info panel to show selected city
  currentCityName = selectedCity.name;
  updateInfoPanel(currentYear);

  return selectedCity;
}

// Grab the single global image for a specific year.
// Each year is one asset named landscan_mosaic_timeseries_YYYY, so there is
// nothing to mosaic - filter the collection down to that one image.
function getYearImage(year) {
  return ee.Image(
    landscanTS
      .filter(ee.Filter.eq('system:index', ASSET_PREFIX + year))
      .first()
  ).select(['population']);
}

// Main function to update global visualization
function updateGlobalVisualization(year) {
  // Remove current layer
  if (currentLayer) {
    Map.remove(currentLayer);
    currentLayer = null;
  }

  currentYear = year;

  // Mask zero-population cells so the basemap shows through unpopulated areas
  var popData = getYearImage(year);
  popData = popData.updateMask(popData.gt(0));

  // Fixed visualization parameters so years stay visually comparable
  var vis = {
    min: 0,
    max: 50,
    palette: beautifulPalette
  };

  currentLayer = ui.Map.Layer(popData, vis, 'Ambient Population ' + year);
  Map.layers().insert(0, currentLayer);

  updateInfoPanel(year);
}

// Function called by date slider
function showPopulationForYear(dateRange) {
  var startDate = ee.Date(dateRange.start());
  var year = startDate.get('year').getInfo();

  // Clamp to the available range in case the slider lands on an edge year
  year = Math.min(Math.max(year, START_YEAR), END_YEAR);

  updateGlobalVisualization(year);
}

// Update information panel
function updateInfoPanel(year) {
  var lines = [
    'LandScan Mosaic Time Series',
    'Ambient population, ' + year,
    year === END_YEAR ?
      '(benchmark reference year)' :
      '(backcast estimate)'
  ];

  if (currentCityName) {
    lines.push('Currently viewing: ' + currentCityName);
  }

  lines.push('Scale: 0-50 people/pixel (3 arc-sec, ~90m)');
  lines.push('');
  lines.push('Click Random City to jump somewhere new!');

  infoLabel.setValue(lines.join('\n'));
}

