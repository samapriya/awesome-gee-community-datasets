    }
  }));
}
legend.add(colorBar);

var labelsPanel = ui.Panel({
  layout: ui.Panel.Layout.Flow('horizontal'),
  style: {margin: '0'}
});

for (var j = 0; j < labels.length; j++) {
  labelsPanel.add(ui.Label({
    value: labels[j],
    style: {
      fontSize: '11px',
      textAlign: 'center',
      width: '33px',
      margin: '0'
    }
  }));
}
legend.add(labelsPanel);
Map.add(legend);

