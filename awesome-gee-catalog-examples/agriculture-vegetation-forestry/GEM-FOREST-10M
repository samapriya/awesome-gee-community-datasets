var legendRow = function(color, label, sublabel) {
  var swatch = ui.Label({
    style: {
      backgroundColor: color,
      padding: '8px',
      margin: '0 6px 0 0',
      border: '1px solid #999'
    }
  });
  var textPanel = ui.Panel({
    layout: ui.Panel.Layout.flow('vertical'),
    style: {margin: '0', padding: '0'}
  });
  textPanel.add(ui.Label({
    value: label,
    style: {margin: '0', padding: '0', fontSize: '12px', fontWeight: 'bold'}
  }));
  if (sublabel) {
    textPanel.add(ui.Label({
      value: sublabel,
      style: {margin: '0', padding: '0', fontSize: '10px', color: '#666'}
    }));
  }
  return ui.Panel({
    widgets: [swatch, textPanel],
    layout: ui.Panel.Layout.flow('horizontal'),
    style: {margin: '0 0 4px 0'}
  });
};

legend.add(legendRow(COLORS.forest,   'Forest',     '>0.5 ha, >5 m, >10% cover'));
legend.add(legendRow(COLORS.treecrop, 'Tree crops', 'oil palm, rubber, olives, etc.'));

