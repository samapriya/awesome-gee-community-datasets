/**
 * Build a try_id → asset-path dict from an ImageCollection.
 * We list the collection's assets client-side (one call) instead of
 * iterating over a folder.
 */
function buildTraitListFromCollection(path) {
  var assets = ee.data.listAssets(path).assets;
  return assets.reduce(function(dict, asset) {
    var m = asset.name.match(/X(\d+)/);
    if (m) dict[m[1]] = asset.name;
    return dict;
  }, {});
}

