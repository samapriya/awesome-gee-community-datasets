// ── show_raster ───────────────────────────────────────────────────────────────

function removeExistingTraitLayers() {
  currentTraitLayers.forEach(function(layer) { Map.layers().remove(layer); });
  currentTraitLayers = [];
}

function show_raster(trait_id) {
  removeExistingTraitLayers();

  // Load the image directly from the collection using its asset path
  var image = ee.Image(currentTraitDict[trait_id]);
  var traitName = idNameDict[trait_id];
  var bandNames = image.bandNames().getInfo();
  metadata = getMetadata(image);

  bandNames.forEach(function(bandName) {
    var bandImage = image.select(bandName);
    var visParams;
    var bn = bandName.toUpperCase();

    if (bn === 'B1') {
      bandImage = bandImage.multiply(metadata.trait_scale).add(metadata.trait_offset);
      visParams = { min: metadata.trait_min, max: metadata.trait_max, palette: makoColormap };
      var l = ui.Map.Layer(bandImage, visParams, traitName, true);
      l.visParams = visParams;
      Map.layers().add(l);
      currentTraitLayers.push(l);

    } else if (bn === 'B2') {
      bandImage = bandImage.multiply(metadata.cov_scale).add(metadata.cov_offset);
      visParams = { min: metadata.cov_min, max: metadata.cov_max, palette: magmaColormap };
      var l = ui.Map.Layer(bandImage, visParams, "Coefficient of variation", false);
      l.visParams = visParams;
      Map.layers().add(l);
      currentTraitLayers.push(l);

    } else if (bn === 'B3') {
      bandImage = bandImage.updateMask(bandImage.neq(0));
      visParams = { min: 0, max: 1, palette: transColormap };
      var l = ui.Map.Layer(bandImage, visParams, "Area of applicability (AOA)", true);
      l.visParams = visParams;
      Map.layers().add(l);
      currentTraitLayers.push(l);
    }
  });

  updateLayerPanel();
  return image;
}

