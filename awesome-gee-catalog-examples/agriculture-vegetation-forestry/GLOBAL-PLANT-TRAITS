function filterTraitNameDict(traitDict) {
  var filtered = [];
  for (var id in traitDict) {
    var cleanId = id.trim();
    if (idNameDict.hasOwnProperty(cleanId)) {
      filtered.push({ key: cleanId, value: idNameDict[cleanId] });
    }
  }
  return filtered;
}

