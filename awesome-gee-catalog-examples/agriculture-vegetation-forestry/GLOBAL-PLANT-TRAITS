function formatUnit(unitStr) {
  if (!unitStr) return "";
  unitStr = String(unitStr)
    .replace(/[\u200B-\u200D\uFEFF\u00A0]/g, '')
    .replace(/\u2212/g, '-')
    .trim();
  var superscriptMap = { '0':'\u2070','1':'\u00B9','2':'\u00B2','3':'\u00B3','4':'\u2074','5':'\u2075','6':'\u2076','7':'\u2077','8':'\u2078','9':'\u2079','-':'\u207B' };
  return unitStr.split(/\s+/).map(function(part) {
    var match = part.match(/^([a-zA-Zμµ]+)(-?\d+)$/);
    if (match) {
      var sup = '';
      for (var i = 0; i < match[2].length; i++) sup += superscriptMap[match[2][i]] || match[2][i];
      return match[1] + sup;
    }
    return part;
  }).join(' ');
}

