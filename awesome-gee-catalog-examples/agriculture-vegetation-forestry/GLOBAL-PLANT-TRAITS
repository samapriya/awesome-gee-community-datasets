Map.onClick(function(clickEvent) {
  if (clickMarker !== null) Map.layers().remove(clickMarker);

  var clickPoint = ee.Geometry.Point(clickEvent.lon, clickEvent.lat);
  var markerCollection = ee.FeatureCollection([ee.Feature(clickPoint)]);
  var markerLayer = ui.Map.Layer(
    markerCollection.style({ color:'#000000', pointSize:7, pointShape:'circle', fillColor:'#00000000' }),
    {}, 'Click Marker'
  );
  clickMarker = markerLayer;
  Map.layers().add(clickMarker);

  if (!raster) {
    locatorContent.clear();
    locatorContent.add(ui.Label("No active raster image available."));
    tableBox.style().set('shown', true);
    return;
  }

  var pt = ee.Geometry.Point(clickEvent.lon, clickEvent.lat);
  var scale = Map.getScale();
  var meta = getMetadata(raster);

  raster.sample({ region: pt, scale: scale, numPixels: 1, seed: 42, dropNulls: false }).evaluate(function(result) {
    locatorContent.clear();
    if (!result.features || result.features.length === 0) {
      locatorContent.add(ui.Label("No data at clicked location."));
      tableBox.style().set('shown', true);
      return;
    }
    var props = result.features[0].properties;
    var b1Value = (props.b1 !== null) ? props.b1 * meta.trait_scale + meta.trait_offset : null;
    var b2Value = (props.b2 !== null) ? props.b2 * meta.cov_scale  + meta.cov_offset  : null;

    var lat = clickEvent.lat, lon = clickEvent.lon;
    var latStr = Math.abs(lat).toFixed(3) + "° " + (lat >= 0 ? 'N' : 'S');
    var lonStr = Math.abs(lon).toFixed(3) + "° " + (lon >= 0 ? 'E' : 'W');

    var infoTable = ui.Panel([
